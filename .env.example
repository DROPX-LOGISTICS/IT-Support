# Copy to .env.local for local work. Never commit real values.
APP_URL=https://support.dropxlogistics.com
ALLOWED_EMAIL_DOMAIN=dropxlogistics.com
ADMIN_EMAILS=first.admin@dropxlogistics.com

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts OAuth credentials stored by Master → Integrations. Generate a long random value.
INTEGRATION_ENCRYPTION_KEY=

# Gmail API sender (see README: "Gmail sender")
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=tech@dropxlogistics.com

# Optional environment fallback. Prefer the encrypted Master → Integrations dashboard setup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
